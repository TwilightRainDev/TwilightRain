<main>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/fancybox/3.5.7/jquery.fancybox.min.css" integrity="sha384-Q8BgkilbsFGYNNiDqJm69hvDS7NCJWOodvfK/cwTyQD4VQA0qKzuPpvqNER1UC0F" crossorigin="anonymous" />
    <%# 移动端胶囊 TOC（2026-08-18 移植自 SanYeCao-blog PostMenu）：
         滚动 80px 后出现固定右上角胶囊按钮，预览当前章节标题，点击展开目录面板；
         桌面端仍是下方双卡布局。ink.js 按断点迁移 toc DOM 到 slot / 面板。
         hidden 由 ink.js 控制：无 h2/h3 的文章不生成 toc，按钮保持隐藏。 %>
    <button class="post-toc-mobile-toggle" type="button" aria-expanded="false" aria-controls="post-toc-mobile-panel" aria-label="目录" hidden>
        <span class="post-toc-mobile-preview" data-toc-preview>目录</span>
        <svg class="post-toc-mobile-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
            <path d="M5 6.5H19M5 12H19M5 17.5H19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
    </button>
    <div id="post-toc-mobile-panel" class="post-toc-mobile-panel" hidden></div>
    <%# 文章页头图并入 TOC 双卡布局（取代原 30vh banner）：
         图卡 + 目录卡并排；移动端图卡堆顶全宽。banner partial 保留给普通页面。 %>
    <div class="post-toc-row">
        <figure class="post-imgcard">
            <% if (page.cover) { %>
            <img src="<%- page.cover %>" data-ori="<%- page.cover.replace('/img/360px/', '/img/ori/') %>" alt="<%= page.title %>" />
            <% } else { %>
            <img data-random-cover alt="<%= page.title %>" />
            <% } %>
        </figure>
        <div class="post-toc-slot"></div>
    </div>
    <article>
        <%- partial('partial/breadcrumbs') %>
        <%# 字数 + 阅读时间：scripts/reading-time.js 构建期注入（中文约 400 字/分钟） %>
        <% if (page.charCount != null || page.readingMinutes) { %>
            <p class="post-reading-meta"><% if (page.charCount != null) { %>约 <%= page.charCount %> 字<% } %><% if (page.charCount != null && page.readingMinutes) { %> · <% } %><% if (page.readingMinutes) { %>阅读约 <%= page.readingMinutes %> 分钟<% } %></p>
        <% } %>
        <%# 文章时效（2026-08-18，Reimu 批一迁移）：过期提示由 post-staleness.js 按
             文章日期标记（超 365 天）；更新时间仅 front matter 显式写 updated 才显示
             （Hexo 默认 updated 取文件 mtime，git checkout 会刷新，直接显示是假数据） %>
        <% if (page.stale) { %>
            <p class="post-stale">本文发布于 <%= date(page.date) %>，距今已 <%= page.staleDays %> 天，内容可能已过时</p>
        <% } %>
        <% if (page.updatedSet) { %>
            <p class="post-updated">更新于 <%= date(page.updated) %></p>
        <% } %>
        <%- page.content %>
        <footer class="post-license">
            <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.zh" target="_blank" rel="noopener">知识共享 署名-非商业性使用-相同方式共享 4.0 国际许可协议</a>
        </footer>
        <%# 分享（2026-08-18，Reimu 批三）：纯链接三平台（微博/QQ/X），无第三方脚本。
             微信省略（官方分享需二维码生成）；page.permalink 为绝对 URL。 %>
        <nav class="post-share" aria-label="分享本文">
            <span class="post-share-label">分享</span>
            <a href="https://service.weibo.com/share/share.php?url=<%- encodeURIComponent(page.permalink) %>&amp;title=<%- encodeURIComponent(page.title) %>" target="_blank" rel="noopener">微博</a>
            <a href="https://connect.qq.com/widget/shareqq/index.html?url=<%- encodeURIComponent(page.permalink) %>&amp;title=<%- encodeURIComponent(page.title) %>" target="_blank" rel="noopener">QQ</a>
            <a href="https://twitter.com/intent/tweet?url=<%- encodeURIComponent(page.permalink) %>&amp;text=<%- encodeURIComponent(page.title) %>" target="_blank" rel="noopener">X</a>
        </nav>
        <%# 双链相关：scripts/wikilinks.js 构建 wikiOutbounds / wikiInbounds（Obsidian [[Title]]） %>
        <% var outs = page.wikiOutbounds || []; var ins = page.wikiInbounds || []; %>
        <% if (outs.length || ins.length) { %>
        <section class="post-wikilinks" aria-label="相关文章">
            <% if (outs.length) { %>
            <div class="post-wikilinks-block">
                <h2 class="post-wikilinks-title">链接到</h2>
                <ul class="post-wikilinks-list">
                    <% outs.forEach(function (item) { %>
                    <li><a href="<%- item.path %>"><%= item.title %></a></li>
                    <% }) %>
                </ul>
            </div>
            <% } %>
            <% if (ins.length) { %>
            <div class="post-wikilinks-block">
                <h2 class="post-wikilinks-title">反向链接</h2>
                <ul class="post-wikilinks-list">
                    <% ins.forEach(function (item) { %>
                    <li><a href="<%- item.path %>"><%= item.title %></a></li>
                    <% }) %>
                </ul>
            </div>
            <% } %>
        </section>
        <% } %>
        <%# 相关文章（2026-08-23，Butterfly 批二）：按标签交集推荐，与双链区块独立 %>
        <% var relatedList = related_posts_list(page); %>
        <% if (relatedList.length) { %>
        <section class="post-related" aria-label="相关文章">
            <h2 class="post-related-title">相关文章</h2>
            <ul class="post-related-list">
                <% relatedList.forEach(function (item) { %>
                <li><a href="<%- url_for(item.path) %>"><%= item.title %></a></li>
                <% }) %>
            </ul>
        </section>
        <% } %>
    </article>
    <% if (page.prev || page.next) { %>
    <nav class="post-prevnext" aria-label="文章导航">
        <% if (page.prev) { %>
        <a class="post-prevnext-link prev" href="<%- url_for(page.prev.path) %>">
            <span class="post-prevnext-label">上一篇</span>
            <span class="post-prevnext-title"><%= page.prev.title %></span>
        </a>
        <% } %>
        <% if (page.next) { %>
        <a class="post-prevnext-link next" href="<%- url_for(page.next.path) %>">
            <span class="post-prevnext-label">下一篇</span>
            <span class="post-prevnext-title"><%= page.next.title %></span>
        </a>
        <% } %>
    </nav>
    <% } %>
    <%- partial('partial/comments') %>
    <%# 最新评论挂件（2026-08-18 移植自 SanYeCao-blog LatestComments，数据源改 GitHub REST）：
         giscus 评论区下方，低调展示最近互动；与 giscus 同条件（评论关闭则不显示）。
         latest-comments.js 拉取 + localStorage 缓存 30 分钟。 %>
    <% if (page.comments !== false && theme.giscus && theme.giscus.enabled && theme.giscus.repo_id && theme.giscus.category_id) { %>
    <div class="latest-comments" data-github-repo="<%= theme.giscus.repo %>">
        <h2 class="latest-comments-title">最新评论</h2>
        <div class="latest-comments-list" aria-live="polite"></div>
    </div>
    <script src="/js/latest-comments.js" defer></script>
    <% } %>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.5.1/jquery.min.js" integrity="sha384-ZvpUoO/+PpLXR1lu4jmpXWu80pZlYUAfxl5NsBMWOEPSjUn/6Z/hRTt8+pR6L4N2" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/fancybox/3.5.7/jquery.fancybox.min.js" integrity="sha384-Zm+UU4tdcfAm29vg+MTbfu//q5B/lInMbMCr4T8c9rQFyOv6PlfQYpB5wItcXWe7" crossorigin="anonymous"></script>
</main>
