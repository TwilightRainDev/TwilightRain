<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5">
    <% if (page.description) { %>
        <meta name="description" content="<%= page.description %>">
    <% } else if (page.excerpt) { %>
        <meta name="description" content="<%= page.excerpt.replace(/<[^>]+>/g, '').trim().substring(0, 200) %>">
    <% } else { %>
        <meta name="description" content="<%= config.description %>">
    <% } %>
    <% if (page.tags && page.tags.length) { %>
        <meta name="keywords" content="<%= page.tags.map(function(tag){return tag.name}).join(',') %>">
    <% } else { %>
        <meta name="keywords" content="<%= config.keywords %>">
    <% } %>

    <!-- Open Graph -->
    <meta property="og:title" content="<%= page.title ? page.title + ' | ' : '' %><%= config.title %>">
    <meta property="og:type" content="<%= page.type === 'tags' || page.type === 'categories' ? 'website' : 'article' %>">
    <meta property="og:url" content="<%= page.permalink || url_for(page.path) %>">
    <meta property="og:site_name" content="<%= config.title %>">
    <meta property="og:locale" content="zh_CN">
    <% if (page.description) { %>
        <meta property="og:description" content="<%= page.description %>">
    <% } else if (page.excerpt) { %>
        <meta property="og:description" content="<%= page.excerpt.replace(/<[^>]+>/g, '').trim().substring(0, 200) %>">
    <% } else { %>
        <meta property="og:description" content="<%= config.description %>">
    <% } %>
    <% if (page.cover) { %>
        <meta property="og:image" content="<%= page.cover %>">
    <% } %>
    <% if (page.date) { %>
        <meta property="article:published_time" content="<%= page.date.toISOString() %>">
    <% } %>
    <% if (page.updated) { %>
        <meta property="article:modified_time" content="<%= page.updated.toISOString() %>">
    <% } %>
    <% if (page.tags && page.tags.length) { %>
        <% page.tags.each(function(tag) { %>
            <meta property="article:tag" content="<%= tag.name %>">
        <% }); %>
    <% } %>

    <!-- RSS -->
    <link rel="alternate" type="application/atom+xml" title="<%= config.title %>" href="<%= url_for('atom.xml') %>">

    <script src="/js/ink.js" defer></script>
    <link rel="shortcut icon" href="<%= url_for(theme.favicon) %>" type="image/x-icon" />
    <title>
        <% if (page.title) { %>
            <%= page.title %> | <% } %><%= config.title %>
    </title>
    <%- css('css/style.min') %>
</head>