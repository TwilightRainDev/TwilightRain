<header>
    <div class="header-top">
        <a class="title" href="/" style="display: flex; align-items: start; text-decoration: none; padding: 0px;">
            <img style="width:var(--size-step-2);margin-right: 5px;height: var(--size-step-2);margin-top: calc(var(--size-step-1) / 2);" src="<%= url_for(theme.favicon) %>"/>
            <%= config.title %><% if (page.title) { %>&nbsp;|&nbsp;<%= page.title %><% } %>
        </a>
    </div>
    <p class="subtitle"><%= config.subtitle %></p>
    <nav class="main-nav">
        <% for (var name in theme.menu) { %>
            <% var item = theme.menu[name]; %>
            <% if (typeof item === 'string') { %>
                <%# 普通菜单项 %>
                <% if (item.indexOf('http') === 0) { %>
                <a href="<%- item %>" target="_blank" rel="noopener"><%= name %></a>
                <% } else { %>
                <a href="<%- url_for(item) %>"><%= name %></a>
                <% } %>
            <% } else { %>
                <%# 二级菜单项：{ url: 可选父链接, children: { 子名: 链接 } } %>
                <span class="has-sub">
                    <% if (item.url) { %>
                        <% if (item.url.indexOf('http') === 0) { %>
                        <a class="sub-trigger" href="<%- item.url %>" target="_blank" rel="noopener"><%= name %></a>
                        <% } else { %>
                        <a class="sub-trigger" href="<%- url_for(item.url) %>"><%= name %></a>
                        <% } %>
                    <% } else { %>
                        <a class="sub-trigger" href="#"><%= name %></a>
                    <% } %>
                    <% if (item.children) { %>
                    <ul class="sub-menu">
                        <% for (var sub in item.children) { %>
                            <% var subUrl = item.children[sub]; %>
                            <li>
                                <% if (subUrl.indexOf('http') === 0) { %>
                                <a href="<%- subUrl %>" target="_blank" rel="noopener"><%= sub %></a>
                                <% } else { %>
                                <a href="<%- url_for(subUrl) %>"><%= sub %></a>
                                <% } %>
                            </li>
                        <% } %>
                    </ul>
                    <% } %>
                </span>
            <% } %>
        <% } %>
    </nav>
</header>
