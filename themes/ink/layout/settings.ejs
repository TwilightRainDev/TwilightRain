<main class="settings-page">
    <h1>设置</h1>
    <p class="settings-desc">以下设置仅保存在当前浏览器（localStorage），不会上传到服务器。</p>

    <section class="setting-group">
        <h2>外观主题</h2>
        <div class="setting-options" role="radiogroup" aria-label="外观主题">
            <label class="setting-option">
                <input type="radio" name="theme" value="auto">
                <span class="setting-option-body">
                    <span class="setting-option-title">跟随系统</span>
                    <span class="setting-option-desc">自动匹配操作系统的深色 / 浅色设置</span>
                </span>
            </label>
            <label class="setting-option">
                <input type="radio" name="theme" value="light">
                <span class="setting-option-body">
                    <span class="setting-option-title">浅色</span>
                    <span class="setting-option-desc">始终使用浅色主题</span>
                </span>
            </label>
            <label class="setting-option">
                <input type="radio" name="theme" value="dark">
                <span class="setting-option-body">
                    <span class="setting-option-title">深色</span>
                    <span class="setting-option-desc">始终使用深色主题</span>
                </span>
            </label>
        </div>
    </section>

    <section class="setting-group">
        <h2>字体</h2>
        <div class="setting-options" role="radiogroup" aria-label="字体">
            <label class="setting-option">
                <input type="radio" name="font" value="lxgw">
                <span class="setting-option-body">
                    <span class="setting-option-title">霞鹜文楷（默认）</span>
                    <span class="setting-option-desc font-preview-wenkai">字体预览：窗前明月光，疑是地上霜。</span>
                </span>
            </label>
            <label class="setting-option">
                <input type="radio" name="font" value="system">
                <span class="setting-option-body">
                    <span class="setting-option-title">系统字体</span>
                    <span class="setting-option-desc">加载更快，跟随操作系统默认字体</span>
                </span>
            </label>
            <label class="setting-option">
                <input type="radio" name="font" value="hywenhei">
                <span class="setting-option-body">
                    <span class="setting-option-title">汉仪文黑 85W</span>
                    <span class="setting-option-desc font-preview-hywenhei">字体预览：窗前明月光，疑是地上霜。</span>
                </span>
            </label>
        </div>
    </section>

    <section class="setting-group">
        <h2>首页布局</h2>
        <div class="setting-options" role="radiogroup" aria-label="首页布局">
            <label class="setting-option">
                <input type="radio" name="home-layout" value="grid">
                <span class="setting-option-body">
                    <span class="setting-option-title">网格（默认）</span>
                    <span class="setting-option-desc">卡片网格展示，可配合下方「首页列数」调整列宽</span>
                </span>
            </label>
            <label class="setting-option">
                <input type="radio" name="home-layout" value="list">
                <span class="setting-option-body">
                    <span class="setting-option-title">列表</span>
                    <span class="setting-option-desc">横向列表展示；列表模式下「首页列数」不生效</span>
                </span>
            </label>
        </div>
    </section>

    <section class="setting-group" id="home-columns-group">
        <h2>首页列数</h2>
        <div class="setting-options" role="radiogroup" aria-label="首页列数">
            <label class="setting-option">
                <input type="radio" name="columns" value="auto">
                <span class="setting-option-body">
                    <span class="setting-option-title">自动（默认）</span>
                    <span class="setting-option-desc">跟随屏幕宽度自适应：电脑 3 列 / 平板 2 列 / 手机 1 列</span>
                </span>
            </label>
            <label class="setting-option">
                <input type="radio" name="columns" value="1">
                <span class="setting-option-body">
                    <span class="setting-option-title">1 列</span>
                    <span class="setting-option-desc">所有屏幕统一单列，卡片占满整行</span>
                </span>
            </label>
            <label class="setting-option">
                <input type="radio" name="columns" value="2">
                <span class="setting-option-body">
                    <span class="setting-option-title">2 列</span>
                    <span class="setting-option-desc">所有屏幕统一双列</span>
                </span>
            </label>
            <label class="setting-option">
                <input type="radio" name="columns" value="3">
                <span class="setting-option-body">
                    <span class="setting-option-title">3 列</span>
                    <span class="setting-option-desc">所有屏幕统一三列</span>
                </span>
            </label>
            <label class="setting-option">
                <input type="radio" name="columns" value="4">
                <span class="setting-option-body">
                    <span class="setting-option-title">4 列</span>
                    <span class="setting-option-desc">所有屏幕统一四列（卡片较小）</span>
                </span>
            </label>
        </div>
    </section>
</main>
