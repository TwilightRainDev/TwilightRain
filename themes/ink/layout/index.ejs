<main>
  <div>
    <% if (theme.notice) { %>
    <div class="notice-bar"><%= theme.notice %></div>
    <% } %>
    <%# 全站分类已并入头部「分类」二级菜单（header.ejs has-sub，2026-08-19），
         首页不再重复输出分类列表 %>
    <ul class="blog-posts">
      <%# 置顶：front matter pinned: true 的文章排最前，其余按日期降序
           （草稿用 source/_drafts，Hexo 原生支持，无需处理） %>
      <% var sortedPosts = page.posts.toArray().sort(function(a, b) {
          var pa = a.pinned ? 1 : 0;
          var pb = b.pinned ? 1 : 0;
          if (pa !== pb) return pb - pa;
          return b.date.diff(a.date);
      }); %>
      <% sortedPosts.forEach(function(item) { %>
        <li class="article-item">
          <a href="<%- url_for(item.path) %>" class="link">
          <% if (item.cover) { %>
          <img src="<%- item.cover %>" data-ori="<%- item.cover.replace('/img/360px/', '/img/ori/') %>" alt="<%- item.title %>" class="thumbnail" loading="lazy" />
          <% } else { %>
          <!-- 无 cover：由 ink.js 每次页面加载从前端封面池随机取图（360px + data-ori） -->
          <img data-random-cover alt="<%- item.title %>" class="thumbnail" loading="lazy" />
          <% } %>
            <div class="article-info">
              <time><%- item.date.format('YYYY/MM/DD') %></time>
              <span><%- item.title || 'untitled' %></span>
              <% if (item.excerpt) { %>
                <% var excerptText = item.excerpt.replace(/<[^>]+>/g, '').trim().substring(0, 100).replace(/\n/g, ' ') + (item.excerpt.replace(/<[^>]+>/g, '').trim().length > 100 ? '...' : '') %>
                <p class="article-excerpt"><%= excerptText %></p>
              <% } %>
            </div>
          </a>
        </li>
      <% }) %>
    </ul>
    
    <nav class="post-navigation">
      <% if(page.prev !== 0){ %>
        <a class="post-nav-btn" href="<%- url_for(page.prev_link)%>">上一页</a>
      <% } %>
      <% if(page.next !== 0){ %>
        <a class="post-nav-btn" href="<%- url_for(page.next_link)%>">下一页</a>
      <% } %>
    </nav>
  </div>
</main>